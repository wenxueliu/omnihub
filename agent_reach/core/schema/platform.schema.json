{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reach-platforms.dev/schema/platform.schema.json",
  "title": "reach-platforms platform manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "actions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "type": "string",
      "enum": ["default", "optional", "experimental"]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["http", "exec", "browser"]
      },
      "uniqueItems": true
    },
    "public_web": {
      "$ref": "#/$defs/public_web"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {"type": "object"},
        "read": {"type": "object"}
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "adapters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "secrets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "auth": {
      "type": "object"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "public_web": {
      "oneOf": [
        {"type": "boolean"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scopes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "priority": {"type": "integer"}
          }
        }
      ]
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["str", "int", "float", "bool", "list"]
        },
        "format": {"type": "string", "enum": ["url"]},
        "required": {"type": "boolean"},
        "default": {},
        "description": {"type": "string"},
        "choices": {"type": "array"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "source": {
      "type": "object",
      "required": ["adapter"],
      "additionalProperties": true,
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "call": {"type": "string", "minLength": 1},
        "args": {"type": "object"},
        "argv": {
          "type": "array",
          "items": {"type": ["string", "number", "boolean"]},
          "minItems": 1
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "get", "post", "put", "patch", "delete"]
        },
        "headers": {"type": "object"},
        "body": {"type": "object"},
        "data": {},
        "url": {"type": "string", "minLength": 1},
        "site": {"type": "string", "minLength": 1},
        "session": {"type": "string", "minLength": 1},
        "parse": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1
            }
          ]
        },
        "priority": {"type": "integer"},
        "when": {"type": "string", "minLength": 1},
        "disabled": {"type": "boolean"},
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "max_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "action": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/param"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "timeout": {"type": "number", "exclusiveMinimum": 0},
        "public_web": {"$ref": "#/$defs/public_web"}
      }
    }
  }
}
